{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engineStrict": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "concurrently -c '#c4b5fd,#fb7185,#fdba74,#93c5fd' --kill-others --names=queue,logs,vite,typescript 'php artisan queue:listen --tries=1 --timeout=0' 'php artisan pail --timeout=0' 'vite' 'php artisan typescript:transform --watch' ",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "analysis:check": "vue-tsc --noEmit",
        "check": "pnpm run format:check && pnpm run lint:check && pnpm run analysis:check"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.2.4",
        "@types/node": "^22.19.17",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/eslint-config-typescript": "^14.7.0",
        "chokidar": "^5.0.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.33.0",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "vite-plugin-watch-and-run": "^1.8.0",
        "vue-tsc": "^2.2.12"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.3",
        "@inertiajs/vue3": "^3.0.3",
        "@lucide/vue": "^1.14.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.1.0",
        "laravel-vue-i18n": "^2.8.0",
        "reka-ui": "^2.9.6",
        "shadcn-vue": "^2.6.2",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.4",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.33",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.9"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.2.4",
        "lightningcss-linux-x64-gnu": "^1.32.0",
        "lightningcss-win32-x64-msvc": "^1.32.0"
    }
}
