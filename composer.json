{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/cashier": "^16.5",
        "laravel/fortify": "^1.34",
        "laravel/framework": "^13.7",
        "laravel/pennant": "^1.23",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "dev-next",
        "spatie/laravel-data": "^4.22",
        "spatie/laravel-permission": "^7.4",
        "spatie/laravel-queueable-action": "^2.17",
        "spatie/laravel-sluggable": "^4.0",
        "spatie/laravel-typescript-transformer": "^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.24",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.2",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "spatie/guidelines-skills": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php artisan storage:link",
            "@php artisan migrate --seed",
            "@php artisan typescript:transform"
        ],
        "format": [
            "vendor/bin/mago format"
        ],
        "format:check": [
            "vendor/bin/mago format --dry-run"
        ],
        "lint": [
            "vendor/bin/mago lint --fix"
        ],
        "lint:check": [
            "vendor/bin/mago lint"
        ],
        "analysis:check": [
            "vendor/bin/mago analyze"
        ],
        "check": [
            "@composer format:check",
            "@composer lint:check",
            "@composer analysis:check"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
